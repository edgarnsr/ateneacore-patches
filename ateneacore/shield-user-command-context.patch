+    /**
+     * Adds the exception for the current user's ID to a field's scoped
+     * uniqueness rule, allowing unchanged values during edits.
+     *
+     * @return array<string, mixed>
+     */
+    private function rulesForExistingUser(string $field, string $userId): array
+    {
+        $rules = $this->validationRules[$field];
+        $fieldRules = is_array($rules['rules'])
+            ? $rules['rules']
+            : explode('|', $rules['rules']);
+        $baseRule = 'unique_' . $field . '_in_registration_group';
+
+        $fieldRules = array_values(array_filter(
+            $fieldRules,
+            static fn ($rule): bool => $rule !== $baseRule,
+        ));
+        $fieldRules[] = $baseRule . '_except[' . $userId . ']';
+        $rules['rules'] = $fieldRules;
+
+        return $rules;
+    }
